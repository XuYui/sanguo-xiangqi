{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "checkJs": false,
    "types": [],
    "paths": {
      "@sanguo/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "apps/server/src/**/*.ts"
  ]
}
